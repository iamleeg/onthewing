FirebaseScript: OTWFirebaseScript {}

webFont: OTWWebFont {}

styleSheet: OTWStyleSheet { stylesheetName = "onthewing.css"; }

hasAvatar: WOConditional {
    condition = hasAvatar;
}

avatarImage: WOImage {
    src = avatarUrl;
    alt = "User Avatar";
}

profileForm: WOForm {
    id = "profile-form";
}

nameInput: WOTextField {
    value = updatedName;
    id = "profile-name";
}

emailInput: WOTextField {
    value = updatedEmail;
    id = "profile-email";
}

updateButton: WOSubmitButton {
    action = updateProfile;
    class = "btn btn-primary";
    value = "Update Profile";
}

backLink: WOHyperlink {
    action = showMain;
    class = "btn btn-secondary";
}

deleteForm: WOForm {
    action = deleteAccount;
    id = "delete-account-form";
    style = "display: none;";
}

AGPLFooter: AGPLFooter {}
