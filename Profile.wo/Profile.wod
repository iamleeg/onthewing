FirebaseScript: OTWFirebaseScript {}

webFont: OTWWebFont {}

styleSheet: OTWStyleSheet { stylesheetName = "onthewing.css"; }

FlashMessage: FlashMessage {}

hasAvatar: WOConditional {
    condition = hasAvatar;
}

avatarImage: WOImage {
    src = avatarUrl;
    alt = "User Avatar";
}

profileForm: WOForm {
    id = "profile-form";
}

nameInput: WOTextField {
    value = updatedName;
    id = "profile-name";
}

emailInput: WOTextField {
    value = updatedEmail;
    id = "profile-email";
}

updateButton: WOSubmitButton {
    action = updateProfile;
    class = "btn btn-primary";
    value = "Update Profile";
}

backLink: WOHyperlink {
    action = showMain;
    class = "btn btn-secondary";
}

manageSubscriptionLink: WOHyperlink {
    action = manageSubscription;
    class = "btn btn-primary";
    style = "width: 100%; text-align: center; display: block; margin-bottom: 1rem; margin-top: 1rem;";
}

membershipStatusString: WOString {
    value = membershipStatusString;
}

isPremiumCondition: WOConditional {
    condition = isPremium;
}

renewalDateString: WOString {
    value = renewalDateString;
}

manageSubscriptionButtonText: WOString {
    value = manageSubscriptionButtonText;
}

deleteForm: WOForm {
    action = deleteAccount;
    id = "delete-account-form";
    style = "display: none;";
}

AGPLFooter: AGPLFooter {}
