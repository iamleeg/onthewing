<?xml version="1.0"?>
<!DOCTYPE gsdoc PUBLIC "-//GNUstep//DTD gsdoc 1.0.4//EN" "http://www.gnustep.org/gsdoc-1_0_4.dtd">
<gsdoc base="BrowseJournal">
  <head>
    <title>
      BrowseJournal - A component that shows an observer
      their nature journal.
    </title>
    <author name="Generated by root"></author>
  </head>
  <body>
    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the BrowseJournal class
      </heading>
      <class name="BrowseJournal" super="GSWComponent">
        <declared>BrowseJournal.h</declared>
        <desc>
          A component that renders the observer's nature journal.
        </desc>
        <ivariable type="JournalEntry*" name="_currentEntry" validity="protected">
          <desc>
            <em>Warning</em> the underscore at the start of the
            name of this instance variable indicates that, even
            though it is not technically <em>private</em>, it is
            intended for internal use within the package, and
            you should not use the variable in other code.
          </desc>
        </ivariable>
        <ivariable type="Observation*" name="_currentObservation" validity="protected">
          <desc>
            <em>Warning</em> the underscore at the start of the
            name of this instance variable indicates that, even
            though it is not technically <em>private</em>, it is
            intended for internal use within the package, and
            you should not use the variable in other code.
          </desc>
        </ivariable>
        <ivariable type="PhotoStorageMover*" name="_photoStorageMover" validity="protected">
          <desc>
            <em>Warning</em> the underscore at the start of the
            name of this instance variable indicates that, even
            though it is not technically <em>private</em>, it is
            intended for internal use within the package, and
            you should not use the variable in other code.
          </desc>
        </ivariable>
        <method type="id">
          <sel>backToMain</sel>
          <desc>
            An action that returns the observer to the
            <ref type="class" id="Main" />
            component.
          </desc>
        </method>
        <method type="id">
          <sel>capture</sel>
          <desc>
            An action that helps an observer to capture a new
            observation. The action sends the observer to
            the <ref type="class" id="Capture" /> component.
          </desc>
        </method>
        <method type="NSArray*">
          <sel>currentEntryObservations</sel>
          <desc>
            Returns the list of observations in the current
            journal entry.
          </desc>
        </method>
        <method type="NSString*">
          <sel>defaultEntryTitle</sel>
          <desc>
            Returns the title for a journal entry that the
            component shows when the observer doesn't provide
            a custom title.
          </desc>
        </method>
        <method type="id">
          <sel>deleteEntry</sel>
          <desc>
            An action that deletes the journal entry that the
            observer indicates. The action returns the
            observer to this component.
          </desc>
        </method>
        <method type="BOOL">
          <sel>hasAnyEntries</sel>
          <desc>
            Returns <code>YES</code> if the observer's journal
            contains one or more entries; <code>NO</code>
            otherwise.
          </desc>
        </method>
        <method type="BOOL">
          <sel>hasCurrentBearing</sel>
          <desc>
            Returns <code>YES</code> if the current observation
            has a compass bearing; <code>NO</code> otherwise.
          </desc>
        </method>
        <method type="BOOL">
          <sel>hasCurrentPhoto</sel>
          <desc>
            Returns <code>YES</code> if the current observation
            has an associated photo; <code>NO</code> otherwise.
          </desc>
        </method>
        <method type="BOOL">
          <sel>hasSummaryPhoto</sel>
          <desc>
            Returns <code>YES</code> if the current journal
            entry has a photo that can be displayed in its
            summary; <code>NO</code> otherwise.
          </desc>
        </method>
        <method type="NSArray*">
          <sel>journalEntries</sel>
          <desc>
            Returns the entries in the observer's journal. The
            list is organised in chronological order with the
            newest entry first.
          </desc>
        </method>
        <method type="NSString*">
          <sel>reflectionsSnippet</sel>
          <desc>
            Returns a brief string that represents the
            observer's reflections on their journal entry.
          </desc>
        </method>
        <method type="NSString*">
          <sel>summaryPhotoURLString</sel>
          <desc>
            Returns the URL to a photo that represents the
            current journal entry; or <code>nil</code> if the
            entry doesn't include a photo.
          </desc>
        </method>
        <method type="id">
          <sel>viewEntry</sel>
          <desc>
            An action that shows the observer the journal entry that
            they indicate. The action sends the observer to the
            <ref type="class" id="ViewJournalEntry" />
            component.
          </desc>
        </method>
      </class>
    </chapter>
  </body>
</gsdoc>
