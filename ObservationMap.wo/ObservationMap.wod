hasLocation:WOConditional { condition = hasValidCoordinates; }
noLocation:WOConditional { condition = hasValidCoordinates; negate = yes; }
leafletScript:OTWLeafletScript {}
observationMapJS:WOJavaScript { scriptSource = "ObservationMap.js"; }
mapContainer:WOGenericContainer { 
    elementName = "div"; 
    id = "observation-map"; 
    style = "height: 300px; width: 100%;";
    data-lat = latitude; 
    data-lng = longitude; 
    data-markers = markersJSON;
}
noLocationMessage:WOString { value = "No location captured"; }
