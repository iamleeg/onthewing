FirebaseScript: OTWFirebaseScript {}
FirebaseAuthUI: FirebaseAuthUI {}
FlashMessage: FlashMessage {}
webFont: OTWWebFont {}
styleSheet: OTWStyleSheet { stylesheetName = "onthewing.css"; }

hasEntries: WOConditional {
    condition = hasAnyEntries;
}

noEntries: WOConditional {
    condition = hasAnyEntries;
    negate = true;
}

entryLoop: WORepetition {
    list = journalEntries;
    item = currentEntry;
}

entryDate: WOString {
    value = currentEntry.date;
    dateformat = "%Y-%m-%d %H:%M";
}

entryTitle: WOString {
    value = currentEntry.title;
    valueWhenEmpty = defaultEntryTitle;
}

viewEntryLink: WOHyperlink {
    action = viewEntry;
}

hasSummaryPhoto: WOConditional {
    condition = hasSummaryPhoto;
}

summaryPhotoImage: WOImage {
    src = summaryPhotoURLString;
    alt = "Journal entry photo";
    width = "100";
}

reflectionsSnippet: WOString {
    value = reflectionsSnippet;
}

deleteEntryLink: WOHyperlink {
    action = deleteEntry;
    class = "btn btn-sm btn-danger";
}

backLink: WOHyperlink {
    action = backToMain;
    class = "btn btn-secondary";
}

captureLink: WOHyperlink {
    action = capture;
    class = "btn btn-primary";
}

AGPLFooter: AGPLFooter {}
