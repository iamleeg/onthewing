<?xml version="1.0"?>
<!DOCTYPE gsdoc PUBLIC "-//GNUstep//DTD gsdoc 1.0.4//EN" "http://www.gnustep.org/gsdoc-1_0_4.dtd">
<gsdoc base="Main">
  <head>
    <title>Main - The landing page for OnTheWing</title>
    <author name="Generated by root"></author>
  </head>
  <body>
    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the Main class
      </heading>
      <class name="Main" super="GSWComponent">
        <declared>Main.h</declared>
        <desc>
          A component that renders the main user interface for the
          OnTheWing app.
        </desc>
        <method type="id">
          <sel>browseJournal</sel>
          <desc>
            An action an observer calls to browse their nature
            journal.
          </desc>
        </method>
        <method type="id">
          <sel>capture</sel>
          <desc>
            An action an observer calls to capture an observation.
            Observations are "pending" in the Session
            until an observer reviews them in the
            ReviewObservations interface, and either
            deletes them or adds them to their journal.
          </desc>
        </method>
        <method type="BOOL">
          <sel>hasObservations</sel>
          <desc>
            A Boolean value that indicates whether the observer has
            pending observations in their Session. Returns
            <code>YES</code> if there are any pending
            observations; <code>NO</code> otherwise.
          </desc>
        </method>
        <method type="BOOL">
          <sel>hasUser</sel>
          <desc>
            A Boolean value that indicates whether the Session is
            associated with an observer. Returns
            <code>YES</code> if an Observer is authenticated in
            the Session; <code>NO</code> otherwise.
          </desc>
        </method>
        <method type="BOOL">
          <sel>isAppReady</sel>
          <desc>
            A Boolean value that indicates whether the OTWApp is
            ready to receive external requests. This component
            displays a placeholder UI when this method returns
            <code>NO</code>.
          </desc>
        </method>
        <method type="NSString*">
          <sel>reportPendingObservations</sel>
          <desc>
            A string that indicates to an observer whether they have
            pending observations in their Session.
          </desc>
        </method>
        <method type="id">
          <sel>reviewObservations</sel>
          <desc>
            An action an observer calls to review their pending
            observations.
          </desc>
        </method>
      </class>
    </chapter>
  </body>
</gsdoc>
