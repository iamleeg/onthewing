appReady:WOConditional { condition = isAppReady; }
appNotReady:WOConditional { condition = isAppReady; negate = true; }
capture_link:WOHyperlink { action = capture; }
has_observations:WOConditional { condition = hasObservations; }
count_observations:WOString { value = reportPendingObservations; }
is_logged_in:WOConditional { condition = hasUser; }
not_logged_in:WOConditional { condition = hasUser; negate = true; }
review_link:WOHyperlink { action = reviewObservations; }
browse_journal_link:WOHyperlink { action = browseJournal; class = "btn btn-secondary"; }
is_logged_in_for_journal:WOConditional { condition = hasUser; }
AGPLFooter:AGPLFooter {}

FirebaseScript: OTWFirebaseScript {}

FirebaseAuthUI: FirebaseAuthUI {}
FlashMessage: FlashMessage {}
webFont: OTWWebFont {}

styleSheet: OTWStyleSheet { stylesheetName = "onthewing.css"; }
