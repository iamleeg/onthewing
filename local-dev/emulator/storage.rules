rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /temp/{userId}/{imageId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Public read: <img src> can't carry an Authorization header, and the
    // temp/ download tokens above are already bypassable by anyone with the
    // URL, so this isn't a weaker exposure. Writes stay server-only (photos
    // land here only via PhotoStorageMover's service-account GCS API calls,
    // which bypass rules entirely - the client SDK can never write here).
    match /journal/{userId}/{journalEntryId}/{imageId} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
